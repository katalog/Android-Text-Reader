# ===============================================
#    .gitignore for Android Studio Projects
# ===============================================

# Built application files (빌드된 애플리케이션 파일)
*.apk
*.aab
*.ap_

# Files for the ART/Dalvik VM (ART/달빅 가상 머신용 파일)
*.dex

# Built native files (빌드된 네이티브 파일)
**/*.so
**/*.a
**/*.dll
**/*.exe

# Build directory (빌드 디렉터리)
build/
.cxx/

# Gradle cache (그래들 캐시)
.gradle/

# Local configuration file (로컬 설정 파일)
# Contains SDK path and other sensitive information.
# SDK 경로 및 민감한 정보를 포함하므로 반드시 제외해야 합니다.
local.properties

# IDE files (Android Studio / IntelliJ)
# IDE(안드로이드 스튜디오) 관련 파일
# .idea/modules.xml, .idea/workspace.xml, and .idea/libraries are user-specific.
# *.iml files are module-specific and are often generated.
*.iml
.idea/workspace.xml
.idea/libraries/
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/deploymentTargetDropDown.xml
.idea/dictionaries/

# Keystore files (VERY IMPORTANT)
# Release signing keys must NEVER be shared.
# 릴리즈 서명 키는 절대 공유해서는 안 됩니다.
*.jks
*.keystore
keystore.properties

# Log files (로그 파일)
*.log
*/build/reports/

# Profiler and memory snapshots (프로파일러 및 메모리 덤프 파일)
captures/
*.hprof
*.prof

# Google services file (구글 서비스 파일)
# If each developer has their own, ignore it. If it's a shared dev file, comment this line out.
# 각 개발자가 자신의 파일을 사용한다면 제외하고, 개발용으로 공유하는 파일이라면 이 줄을 주석 처리하세요.
google-services.json

# Temporary files from Android Studio (안드로이드 스튜디오 임시 파일)
.DS_Store
Thumbs.db

# Kover reports (코틀린 코드 커버리지 리포트)
**/reports/kover

# Scratch screenshots/UI dumps from device testing
.tmp_screens/

# Raw icon export (source files for app/web/ios icons; applied copies live under res/)
.tmp_icon/

# Test fixture novels (실제 번역 웹소설 텍스트 — 저작권 및 용량 문제로 로컬에만 두고 커밋하지 않음)
app/src/androidTest/assets/books/