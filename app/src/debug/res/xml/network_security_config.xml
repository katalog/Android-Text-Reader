<?xml version="1.0" encoding="utf-8"?>
<!-- debug 소스셋 전용 — 릴리스 빌드에는 병합되지 않는다(릴리스는 res/xml의 같은 이름 파일 참고).
     원래는 FontDownloadManagerTest가 쓰는 MockWebServer(로컬 가짜 HTTP 서버)만 예외로 뒀었는데,
     PC 파일 동기화(.docs/PC_SYNC_SERVER_PLAN.md)가 사용자가 입력한 LAN 호스트로 평범한 http를
     쓰게 되면서 전체 허용으로 넓힘 — 릴리스와 동일하게 맞춰야 실기기(디버그 빌드) 검증이 실제
     사용자 경험과 어긋나지 않는다. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
