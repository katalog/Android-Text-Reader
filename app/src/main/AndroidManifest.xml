<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 무료 한글 폰트 다운로드 기능에만 사용 (그 외 모든 기능은 오프라인 동작) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PC 파일 동기화(.docs/PC_SYNC_SERVER_PLAN.md)의 로컬 서브넷 스캔용 — 현재 연결된 네트워크의
         링크 정보(로컬 IP)를 얻는 데만 쓰고 그 외 트래픽 감청 등은 하지 않음 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- PC 파일 동기화가 평범한 http(TLS 없음)를 쓰는 이유와 범위는 res/xml/network_security_config.xml
         참고 — 실제 cleartext 허용 여부는 usesCleartextTraffic이 아니라 그 설정 파일이 결정한다
         (networkSecurityConfig가 있으면 usesCleartextTraffic은 무시됨). debug 빌드는 별도
         src/debug/AndroidManifest.xml + src/debug/res/xml/network_security_config.xml로 재정의됨
         (MockWebServer 테스트 때문에 예전부터 있던 파일 — 실기기 검증 중 이게 있는 줄 모르고
         usesCleartextTraffic만 켰다가 여전히 막히는 걸 겪고 알게 됨). -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.TextReader">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TextReader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
